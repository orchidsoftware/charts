{
    "name": "orchid/charts",
    "description": "PHP-first server-side SVG charts for dashboards. Zero JavaScript runtime.",
    "keywords": [
        "charts", "svg", "chart", "dashboard", "visualization",
        "laravel", "orchid", "server-side", "svg-charts"
    ],
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3"
    },
    "autoload": {
        "psr-4": {
            "Orchid\\Charts\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Orchid\\Charts\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Alexandr Chernyaev",
            "email": "bliz48rus@gmail.com"
        }
    ],
    "require-dev": {
        "phpunit/phpunit": "^13.1",
        "laravel/pint": "^1.29",
        "rector/rector": "^2.4",
        "phpstan/phpstan": "^2.1",
        "infection/infection": "^0.32"
    },
    "scripts": {
        "test": "phpunit",
        "coverage": "php -d pcov.enabled=1 -d pcov.directory=$PWD/src vendor/bin/phpunit --coverage-text",
        "pint": "pint",
        "phpstan": "phpstan analyse --level=max src tests",
        "psalm": "psalm --no-cache",
        "rector": "rector process --dry-run",
        "infection": "infection --initial-tests-php-options='-d pcov.enabled=1 -d pcov.directory=$PWD/src'"
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        }
    }
}
