{
  "name": "@orchidsoftware/charts",
  "version": "0.0.5",
  "description": "Clear, responsive SVG charts for product interfaces with one small JavaScript API",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./style.css": {
      "types": "./src/styles.d.ts",
      "default": "./src/styles.css"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./src/index.d.ts",
  "style": "./src/styles.css",
  "homepage": "https://charts.orchid.software",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orchidsoftware/charts.git"
  },
  "bugs": {
    "url": "https://github.com/orchidsoftware/charts/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "docs",
    "src/index.d.ts",
    "src/styles.d.ts",
    "src/styles.css",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "dev": "vite --open /demo/",
    "build": "npm run build:library && node scripts/WriteBuildSize.mjs",
    "build:demo": "vite build --config ViteDemoConfig.js",
    "preview": "vite preview",
    "format": "prettier --write \"**/*.{js,mjs,cjs,ts,css,html,md,json,yml,yaml}\" --ignore-unknown",
    "format:check": "prettier --check \"**/*.{js,mjs,cjs,ts,css,html,md,json,yml,yaml}\" --ignore-unknown",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:fix": "npm run lint:js:fix && npm run lint:css:fix",
    "lint:js": "eslint . --max-warnings 0",
    "lint:js:fix": "eslint . --fix --max-warnings 0",
    "lint:css": "stylelint \"{src,demo}/**/*.css\" --max-warnings 0",
    "lint:css:fix": "stylelint \"{src,demo}/**/*.css\" --fix --max-warnings 0",
    "typecheck": "tsc -p tsconfig.types.json --module ESNext --moduleResolution Bundler && tsc -p tsconfig.types.json --module Node16 --moduleResolution Node16 && tsc -p tsconfig.types.json",
    "test": "vitest run --project node --project browser-chromium",
    "test:size": "npm run build",
    "test:lab": "vitest run --project site-chromium test/Lab.test.js",
    "test:watch": "vitest --project node --project browser-chromium",
    "test:visual": "vitest run --project visual-chromium",
    "test:visual:update": "vitest run --project visual-chromium --update",
    "test:performance": "vitest run --project performance-chromium",
    "test:compatibility": "ORCHID_CHARTS_COMPATIBILITY=1 vitest run",
    "test:no-build": "npm run build:library && node scripts/TestNoBuild.mjs",
    "test:ssr": "npm run build:library && npm run test:ssr:built",
    "coverage": "vitest run --coverage --exclude test/Performance.test.js",
    "audit": "npm audit --audit-level=high",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "check": "npm run format:check && npm run lint && npm run test:policies && npm run typecheck && npm run coverage && npm run test:performance && npm run test:compatibility && npm run test:touch && npm run test:frameworks && npm run build && npm run test:dist",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "build:library": "vite build",
    "test:dist": "node scripts/TestNoBuild.mjs && node scripts/TestPackage.mjs && npm run test:ssr:built",
    "test:ssr:built": "node --input-type=module --eval \"await import('./dist/index.js')\"",
    "test:policies": "node --test test-node/*.test.mjs",
    "test:all": "vitest run",
    "test:unit": "vitest run --project node",
    "test:site": "vitest run --project site-chromium",
    "test:input": "vitest run --project input-chromium",
    "test:touch": "node scripts/TestTouch.mjs",
    "test:frameworks": "node scripts/TestFrameworks.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "eslint-plugin-sonarjs": {
      "typescript": "5.9.3"
    },
    "@typescript-eslint/utils": {
      "typescript": "5.9.3"
    },
    "ts-api-utils": {
      "typescript": "5.9.3"
    }
  },
  "keywords": [
    "accessible",
    "calendar-heatmap",
    "charting-library",
    "charts",
    "dashboard",
    "data-visualization",
    "dependency-free",
    "bubble-chart",
    "javascript",
    "product-analytics",
    "radar-chart",
    "responsive-charts",
    "scatter-plot",
    "svg",
    "svg-charts",
    "timeline-chart",
    "typescript",
    "visualization"
  ],
  "author": {
    "name": "Alexander Chernyaev",
    "url": "https://github.com/tabuna"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hotwired/stimulus": "3.2.2",
    "@hotwired/turbo": "8.0.23",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.9.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^64.2.1",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^73.0.0",
    "globals": "^17.11.0",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-multiline-arrays": "^4.1.11",
    "sass": "^1.103.1",
    "stylelint": "^17.14.1",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-standard": "^40.0.0",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
